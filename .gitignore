# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging / test artifacts
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# Tacode run logs
log_tacode
log_tacode_montecarlo
log_montecarlo_animation

# Monte-Carlo working directories generated by tacode-montecarlo.py
# (montecarlo.work_dir in config.yml; created next to the case directory)
tutorial/work_montecarlo/work_montecarlo/
tutorial/work_montecarlo_wind/work_montecarlo_wind/

# Gathered Monte-Carlo results (montecarlo.result_dir in config.yml)
tutorial/work_montecarlo/result_tacode/
tutorial/work_montecarlo_wind/result_tacode/

# Figures and animations drawn by the tools in src_helper/
tutorial/work_montecarlo*/montecarlo_dispersion*
tutorial/work_montecarlo*/dispersion.*
tutorial/*/attitude.gif
tutorial/*/attitude.html
tutorial/*/attitude.mp4
tutorial/*/attitude.png

# The wind-table case is a demonstration, not a reference output
tutorial/work_reentry_wind_table/output_result/
tutorial/work_reentry_wind_table/output_restart/

# Validation runs (the cases are reproducible; their numbers are recorded in the READMEs)
validation/*/output_*/

# Editor / OS
*.swp
*~
.DS_Store
.idea/
.vscode/

# NOTE:
# tutorial/work/output_result/ and tutorial/work/output_restart/ are tracked
# on purpose as reference outputs. Do not ignore them.

# Local-only notes (not published)
CLAUDE.md
CLAUDE_ARCHIVE_*.md
CODE_REVIEW_*.md
FEASIBILITY_*.md
HANDOVER_*.md
references/

# Jupyter
.ipynb_checkpoints/
